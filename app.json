{
  "expo": {
    "name": "travi",
    "slug": "travi",
    "description": "Collect the places you love. Find your next favorite with travi.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "travi",
      "cmhmobileapp"
    ],
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "xyz.ecao.cmhmobileapp",
      "appleTeamId": "GX759G42VQ"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#909DC3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "xyz.ecao.cmhmobileapp",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#909DC3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 112
        }
      ],
      "expo-secure-store",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Travi uses photo locations to match landmarks and automatically upload new matching photos when you enable automatic collection. You can also attach photos manually.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Travi uses your location to detect landmark visits and show you on the globe. Location sharing is only with friends you choose.",
          "locationAlwaysAndWhenInUsePermission": "Travi uses your location in the background for friend sharing and automatic landmark collection, only when you enable these features.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Travi uses photo locations to match landmarks and automatically upload new matching photos when you enable automatic collection. You can also attach photos manually.",
          "savePhotosPermission": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Travi checks which of your contacts already use the app so you can add them as friends. Phone numbers are hashed on your device before they are compared."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#909DC3"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
